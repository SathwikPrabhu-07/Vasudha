# ── Vasudha Backend Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.

# ── Firebase ────────────────────────────────────────────────────────────────────
# Option 1: Path to service account JSON file (local development)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Option 2: Inline JSON string (for cloud hosts like Render)
# Paste the entire contents of your serviceAccountKey.json here as a single line
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Email (Brevo SMTP) ─────────────────────────────────────────────────────────
EMAIL_ADDRESS=your-brevo-email@example.com
EMAIL_APP_PASSWORD=your-brevo-smtp-key

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Frontend URL (used in notification emails) ─────────────────────────────────
FRONTEND_URL=http://localhost:5173
